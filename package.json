    "audit:trilha-integrity": "node scripts/audit-trilha-integrity.js"
  },
  "dependencies": {
    "firebase-admin": "^13.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.7"
  }
}
