// Arquivo: firestore.rules
// Wave B / Ciclo 3 Red Team (I8 / ADR-008):
// - Progresso do aluno NÃO é writable no Client SDK (só Admin SDK / API).
// - Logs/attempts: write só via API.
// - Leituras sensíveis exigem Firebase Auth (painel admin).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /institutions/{institutionId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /trails/{trailId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn()
        && request.resource.data.institution_id == resource.data.institution_id;
      allow delete: if false;
    }

    match /trail_stages/{trailStageId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /trail_stage_questions/{questionId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // RT-C2 / ADR-008: progresso só via Admin SDK (API/motor).
    match /student_trails/{studentTrailId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /conversation_logs/{logId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /exercise_attempts/{attemptId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /admin_users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /counters/institutions {
      allow read, write: if signedIn();
    }
    match /counters/students {
      allow read, write: if signedIn();
    }
    match /counters/trails {
      allow read, write: if signedIn();
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
